import sqlite3
import pandas as pd

# Nos conectamos a la base de datos en memoria
conn = sqlite3.connect(':memory:')

# Se crear y llena las tablas para asegurar los datos
conn.execute('CREATE TABLE users (user_id INTEGER PRIMARY KEY);')
conn.execute('''
CREATE TABLE orders (
    order_id INTEGER PRIMARY KEY,
    user_id INTEGER,
    order_date DATE,
    total_amount REAL
);
''')

conn.execute('INSERT INTO users (user_id) VALUES (1), (2), (3);')
conn.executemany('''
INSERT INTO orders (order_id, user_id, order_date, total_amount) VALUES (?, ?, ?, ?);
''', [
    (101, 1, '2026-08-15', 50.0),
    (102, 1, '2026-09-10', 75.0),
    (103, 2, '2026-07-20', 120.0),
    (104, 1, '2026-09-25', 60.0),
    (105, 3, '2026-08-01', 30.0),
    (106, 2, '2026-09-05', 90.0)
])
conn.commit()

# Definimos la consulta RFM exacta
query = '''
WITH constants AS (
    SELECT CAST('2026-10-01' AS DATE) AS analysis_date
),

user_monthly_spend AS (
    SELECT
        user_id,
        STRFTIME('%Y-%m-01', order_date) AS order_month,
        SUM(COALESCE(total_amount, 0)) AS monthly_amount
    FROM orders
    GROUP BY user_id, STRFTIME('%Y-%m-01', order_date)
),

trend_calculations AS (
    SELECT
        user_id,
        order_month,
        monthly_amount,
        AVG(monthly_amount) OVER(PARTITION BY user_id) AS avg_historical_spend,
        ROW_NUMBER() OVER(PARTITION BY user_id ORDER BY order_month DESC) AS rn
    FROM user_monthly_spend
),

user_trend AS (
    SELECT
        user_id,
        (monthly_amount - avg_historical_spend) AS spend_trend
    FROM trend_calculations
    WHERE rn = 1
),

rfm_base AS (
    SELECT
        u.user_id,
        MAX(o.order_date) AS last_purchase_date,
        COUNT(DISTINCT o.order_id) AS frequency,
        SUM(o.total_amount) AS monetary_raw
    FROM users u
    LEFT JOIN orders o ON u.user_id = o.user_id
    GROUP BY u.user_id
)

SELECT
    b.user_id,
    COALESCE(JULIANDAY(c.analysis_date) - JULIANDAY(b.last_purchase_date), 999) AS recency,
    COALESCE(b.frequency, 0) AS frequency,
    COALESCE(b.monetary_raw, 0) AS monetary,
    ROUND(COALESCE(t.spend_trend, 0), 2) AS trend
FROM rfm_base b
CROSS JOIN constants c
LEFT JOIN user_trend t ON b.user_id = t.user_id;
'''

# Ejecutamos con pandas para obtener el DataFrame directo sin usar prettytable
df_rfm = pd.read_sql_query(query, conn)
display(df_rfm)
